# ---------------------------------------------------------------------------
# GENBRIK website — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys). Required for the contact form
# to deliver email in production. Without it, the API route logs submissions to
# the server console in development only and reports a configuration error in
# production.
RESEND_API_KEY=

# Where contact submissions are delivered.
CONTACT_TO_EMAIL=info@genbrik.com

# Verified sender on your Resend account. The domain must be verified in Resend
# before go-live; `onboarding@resend.dev` only delivers to the account owner and
# exists for testing.
CONTACT_FROM_EMAIL="GENBRIK Website <onboarding@resend.dev>"

# Canonical site origin used for metadata, sitemap and robots.
# Local: http://localhost:3000   Production: https://genbrik.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Contact endpoint limit per IP within a 10 minute window (default 5).
CONTACT_RATE_LIMIT_MAX=5
